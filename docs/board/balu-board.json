      "width": 340,
      "height": 190,
      "type": "text",
      "style": "body",
      "content": "<b>⊘ 0.1 · Фото Балу</b><br><span style=\"font-size:0.62em\">силует при денному світлі + портрет</span>",
      "color": "#939597"
