    {
      "id": "it-f3-4",
      "x": 1410,
      "y": 1130,
      "width": 340,
      "height": 190,
      "type": "text",
      "style": "body",
      "content": "<b>▣ 3.5 · Відкат на архетип</b><br><span style=\"font-size:0.62em\">силуетний сайтхаунд у палітрі Балу, якщо файл побитий або спайк провалився</span>",
      "color": "#88B04B"
    },
