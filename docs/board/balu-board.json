      "id": "sec-f4",
      "type": "text",
      "x": 1840,
      "y": 0,
      "width": 400,
      "height": 130,
      "style": "heading",
      "color": "#009B77",
      "content": "<b>Ф4 · ІНТЕРФЕЙС</b><br><span style=\"font-size:0.52em\">BaluUI — лігво, дошка, лист, герольд</span><br><span style=\"font-size:0.48em\">8 / 8</span>"
