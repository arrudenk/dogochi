    {
      "id": "it-f3-0",
      "x": 1410,
      "y": 250,
      "width": 340,
      "height": 190,
      "type": "text",
      "style": "body",
      "content": "<b>▣ 3.1 · Захоплення 5 поз</b><br><span style=\"font-size:0.62em\">силуетні підказки, поради про світло й фон</span>",
